# MD Academy production environment: add directly in Vercel, never commit real credentials.
# Use the same UniteHQ Supabase project; the publishable key is safe for browsers but NOT a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://xkubmjogdwsywdlpvydt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<get publishable key from Supabase project settings>
# Required: HTTPS origin on the verified custom domain, without a path or trailing slash.
ACADEMY_ORIGIN=https://<your-purchased-domain>
# Until this is set, Academy sign-in intentionally returns 503.
